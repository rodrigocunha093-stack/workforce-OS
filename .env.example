# Variáveis de ambiente — TáÓtimo!
# Copie para .env (local) ou configure no Vercel (produção). NUNCA versione valores reais.

# --- Supabase (persistência/auth REAL — em uso) ---
# Chave do Supabase usada por db-supabase.js (@supabase/supabase-js).
SUPABASE_KEY=coloque-a-chave-no-ambiente

# --- Código de convite do piloto (registro) ---
PILOT_INVITE_CODE=troque-este-codigo-no-ambiente

# --- PostgreSQL direto (LEGADO — db.js é stub, não usa mais) ---
# Mantidas por compatibilidade. Não são necessárias para rodar.
PGHOST=localhost
PGPORT=5432
PGDATABASE=meu_sistema
PGUSER=postgres
# PGPASSWORD só no ambiente local; nunca versionar.

# Porta do servidor (default 4173 se ausente)
PORT=4173
